{
  "source": {
    "repo": "utcp-specification",
    "path": "docs/protocols/streamable-http.md",
    "line": 170
  },
  "kind": "tool",
  "expect": "accept",
  "reason": "Spec example of a valid UTCP tool.",
  "document": {
    "name": "download_dataset",
    "description": "Download large dataset files",
    "inputs": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "csv",
            "json",
            "parquet"
          ]
        }
      },
      "required": [
        "dataset_id"
      ]
    },
    "tool_call_template": {
      "call_template_type": "streamable_http",
      "url": "https://data.example.com/datasets/{dataset_id}/download",
      "http_method": "GET",
      "chunk_size": 8192,
      "timeout": 300000,
      "header_fields": [
        "format"
      ],
      "auth": {
        "auth_type": "api_key",
        "api_key": "${DATA_API_KEY}",
        "var_name": "X-API-Key",
        "location": "header"
      }
    }
  }
}
